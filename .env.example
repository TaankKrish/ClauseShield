# ClauseShield Environment Configuration Example
# Copy this file to .env and provide your private keys/configurations.
# NEVER commit the .env file to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API
# Server-side only: never expose this key to Vite client bundle (no VITE_ prefix!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Client Configuration (Exposed to frontend via Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ENABLE_MOCK_FALLBACK=true
